{
  // PB38: the first cases, read through the accessibility tree.

  "fixtures": [
    {
      "name": "the window a default installation opens",
      "arguments": [],
      "shareable": true
    },
    {
      // PB23: --open reaches a photo without a dialog; the drop itself has its own case below (WW550).
      // The path is relative to winwright.json's folder, where the app is started (WW508).
      "name": "a window opened on the rotated JPEG fixture",
      "arguments": ["--open", "tests/fixtures/images/rotated-exif6.jpg", "--provider", "cpu"],
      "shareable": true
    },
    {
      // PB24: a photo open and a models folder with nothing in it, so the panel must say so.
      "name": "a window with a photo open and no models",
      "arguments": ["--open", "tests/fixtures/images/rotated-exif6.jpg", "--models", "tests/fixtures/images", "--provider", "cpu"],
      "shareable": true
    },
    {
      // PB58: not lent, since its case opens the download offer and answers it.
      "name": "a window with a photo open and no models, to answer a download offer",
      "arguments": ["--open", "tests/fixtures/images/rotated-exif6.jpg", "--models", "tests/fixtures/images", "--provider", "cpu"],
      "shareable": false
    },
    {
      // PB60: 4100 px a side, so 4x (16400 px) is past the 16384 px limit and 2x is within it.
      // Not lent: its case changes the factor.
      "name": "a window with a 4100 px photo open",
      "arguments": ["--open", "tests/fixtures/images/large-4100.png", "--models", "tests/fixtures/images", "--provider", "cpu"],
      "shareable": false
    },
    {
      // PB25: a photo with transparency, so choosing JPEG has something to lose.
      "name": "a window with a transparent photo open",
      "arguments": ["--open", "tests/fixtures/images/alpha-lossless.webp", "--models", "tests/fixtures/images", "--provider", "cpu"],
      "shareable": false
    },
    {
      // PB45: a photo with camera details, exported with the default format (PNG).
      "name": "a window with a camera photo open",
      "arguments": ["--open", "tests/fixtures/images/exif-camera.jpg", "--models", "tests/fixtures/images", "--provider", "cpu"],
      "shareable": false
    },
    {
      "name": "a window asked to open a file that is not there",
      "arguments": ["--open", "tests/fixtures/images/missing.png", "--provider", "cpu"],
      "shareable": true
    },
    {
      // PB39: --provider cpu, which a case uses to be the same on every desk.
      "name": "a window forced onto the CPU",
      "arguments": ["--provider", "cpu"],
      "shareable": true
    },
    {
      // PB43: --provider winml, which asks for a provider Windows ML installed for this PC.
      "name": "a window asked for Windows ML",
      "arguments": ["--provider", "winml"],
      "shareable": true
    },
    {
      // PB57: not lent, since a drop opens a photo in it.
      "name": "an empty window to drop a photo on",
      "arguments": ["--provider", "cpu"],
      "shareable": false
    },
    {
      // PB57: a photo staged in a folder of its own, so the Save dialog writes there.
      "name": "a window on a staged photo, to save through the dialog",
      "files": ["tests/fixtures/images/rotated-exif6.jpg"],
      "arguments": ["--open", "{files}/rotated-exif6.jpg", "--provider", "cpu"],
      "shareable": false
    },
    {
      // PB64: not lent, since a second photo is dropped on it.
      "name": "a window on the rotated JPEG fixture, to drop another file on",
      "arguments": ["--open", "tests/fixtures/images/rotated-exif6.jpg", "--provider", "cpu"],
      "shareable": false
    },
    {
      // PB65: not lent, since its case edits the photo.
      "name": "a window on the rotated JPEG fixture, to edit",
      "arguments": ["--open", "tests/fixtures/images/rotated-exif6.jpg", "--provider", "cpu"],
      "shareable": false
    },
    {
      // PB63: the same, for the toolbar's Save as.
      "name": "a window on a staged photo, to save from the toolbar",
      "files": ["tests/fixtures/images/rotated-exif6.jpg"],
      "arguments": ["--open", "{files}/rotated-exif6.jpg", "--provider", "cpu"],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "a default installation puts a window named Revelei on the desk",
      "catches": "an app that builds its window and then shows something else, or nothing at all, which every in-process test would pass",
      "filed": "PB38",
      "tags": ["smoke", "window"],
      "fixture": "the window a default installation opens",
      "steps": [
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "Revelei$",
          "named": "the title bar ends in the app's name"
        }
      ]
    },

    {
      // PB14: the status bar names where inference runs once detection has finished, whatever the
      // desk has: DirectML on a GPU, or CPU with or without a reason.
      "name": "the status bar says whether inference runs on the GPU or the CPU",
      "catches": "a status bar stuck on Detecting GPU, which is what a detection that hangs or throws would leave",
      "filed": "PB38",
      "tags": ["smoke", "window", "provider"],
      "fixture": "the window a default installation opens",
      "steps": [
        {
          "locator": "Text#ProviderStatus",
          "act": "read",
          "reads": "name",
          "matches": "^(DirectML · |CPU)",
          "named": "the provider chip names DirectML or CPU"
        }
      ]
    },

    {
      "name": "--provider cpu runs inference on the CPU whatever GPU the desk has",
      "catches": "a --provider flag that is parsed and then ignored, leaving detection to pick the GPU",
      "filed": "PB39",
      "tags": ["smoke", "provider", "command-line"],
      "fixture": "a window forced onto the CPU",
      "steps": [
        {
          "locator": "Text#ProviderStatus",
          "act": "read",
          "reads": "name",
          "expect": "CPU",
          "named": "the provider chip says CPU and nothing else"
        }
      ]
    },

    {
      // PB43: TensorRT-RTX on the RTX 4060 desk; a desk Windows ML has nothing for gets what auto picks.
      "name": "--provider winml names the provider it ended up on",
      "catches": "a Windows ML catalog that throws or hangs, leaving the chip on Detecting GPU",
      "filed": "PB43",
      "tags": ["smoke", "provider", "command-line"],
      "fixture": "a window asked for Windows ML",
      "steps": [
        {
          "locator": "Text#ProviderStatus",
          "act": "read",
          "reads": "name",
          "matches": "^((TensorRT-RTX|OpenVINO|DirectML) · |CPU)",
          "named": "the provider chip names a Windows ML provider, DirectML or CPU"
        }
      ]
    },

    {
      "name": "a default installation opens on the drop zone with a way to pick a file",
      "catches": "a first screen with nothing on it to open a photo with",
      "filed": "PB23",
      "tags": ["smoke", "open"],
      "fixture": "the window a default installation opens",
      "steps": [
        {
          "locator": "Button#OpenButton",
          "act": "read",
          "reads": "name",
          "expect": "Open image…",
          "named": "the open button is on the first screen"
        }
      ]
    },

    {
      // PB63: a narrowed window moving the buttons into the overflow menu has no case, since
      // winwright cannot resize a window (WW570).
      "name": "the toolbar offers Open on the empty screen and keeps what needs a photo off",
      "catches": "a toolbar that only appears with a photo, or whose Save as and Undo can be pressed with nothing open",
      "filed": "PB63",
      "tags": ["smoke", "toolbar"],
      "fixture": "the window a default installation opens",
      "steps": [
        {
          "locator": "Button#ToolbarOpen",
          "act": "read",
          "reads": "name",
          "expect": "Open",
          "named": "the toolbar names its Open button"
        },
        {
          "locator": "Button#ToolbarOpen",
          "act": "read",
          "reads": "enabled",
          "expect": "enabled",
          "named": "and it can be pressed"
        },
        {
          "locator": "Button#ToolbarSaveAs",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "Save as waits for a photo"
        },
        {
          "locator": "Button#UndoButton",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and so does Undo"
        }
      ]
    },

    {
      "name": "the toolbar's Save as writes the photo through the same dialog as the Export card",
      "catches": "a toolbar Save as that is drawn and does nothing, or saves without the card's format",
      "filed": "PB63",
      "tags": ["toolbar", "export", "dialog"],
      "fixture": "a window on a staged photo, to save from the toolbar",
      "steps": [
        {
          "locator": "Button#ToolbarSaveAs",
          "act": "invoke",
          "named": "the toolbar's Save as is pressed"
        },
        {
          "locator": "Window[class=\"#32770\"]",
          "act": "choose file",
          "with": "{files}/toolbar.png",
          "named": "the dialog is told to save toolbar.png in the staged folder"
        },
        {
          "locator": "Text#ExportStatus",
          "act": "read",
          "reads": "name",
          "expect": "Saved toolbar.png",
          "named": "the export card says it saved toolbar.png"
        }
      ]
    },

    {
      "name": "a photo dropped from Explorer on the empty screen opens upright",
      "catches": "a drop zone that accepts the drag and opens nothing, or ignores the file's EXIF orientation",
      "filed": "PB57",
      "tags": ["open", "drop"],
      "fixture": "an empty window to drop a photo on",
      "steps": [
        {
          // Released over the drop zone's button: the zone itself is a Border, which has no
          // automation peer, and the window's drop handler takes a drop anywhere on it.
          "locator": "Button#OpenButton",
          "act": "drop file",
          "with": "tests/fixtures/images/rotated-exif6.jpg",
          "named": "the photo is dropped on the drop zone"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — 8 × 16",
          "named": "it opens, named and upright"
        }
      ]
    },

    {
      // PB64: the surface is a child window of its own, so this is the drop that used to have
      // nowhere to land once a photo was open. No edits, so nothing is asked.
      "name": "a file dropped on the open photo replaces it, or says why not and keeps it",
      "catches": "a second photo that can only be reached by restarting, or a bad file that throws the open photo away",
      "filed": "PB64",
      "tags": ["open", "drop"],
      "fixture": "a window on the rotated JPEG fixture, to drop another file on",
      "steps": [
        {
          "locator": "Slider#Surface",
          "act": "drop file",
          "with": "tests/fixtures/images/README.md",
          "named": "a file that is not an image is dropped on the photo"
        },
        {
          "locator": "Text#ViewerOpenError",
          "act": "read",
          "reads": "name",
          "expect": "README.md is not an image Windows can open.",
          "named": "it says why over the photo"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — 8 × 16",
          "named": "and the photo stays"
        },
        {
          "locator": "Slider#Surface",
          "act": "drop file",
          "with": "tests/fixtures/images/alpha-lossless.webp",
          "named": "another photo is dropped on it"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "alpha-lossless.webp — 4 × 2",
          "named": "it replaces the first"
        },
        {
          "locator": "List#History > ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "1. Opened alpha-lossless.webp",
          "named": "with a history of its own"
        },
        {
          "locator": "Text#ViewerOpenError",
          "act": "read",
          "absent": true,
          "named": "and the earlier refusal is gone"
        }
      ]
    },

    {
      // PB65: the pixels themselves are ImageTransformsTests'; this is the toolbar, the keys
      // and the history. The keys go to the Fit button, since the photo surface is a child
      // window whose keys never reach WPF's bindings.
      "name": "the photo is turned from the toolbar and the keyboard, each turn a version that undoes",
      "catches": "a rotate button that does nothing, turns the wrong way, or turns without a history entry to undo",
      "filed": "PB65",
      "tags": ["toolbar", "edit", "history"],
      "fixture": "a window on the rotated JPEG fixture, to edit",
      "steps": [
        {
          "locator": "Button#RotateRightButton",
          "act": "invoke",
          "named": "Rotate right is pressed"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — Rotate right — 16 × 8",
          "named": "the 8 x 16 photo is now 16 x 8"
        },
        {
          "locator": "List#History > ListItem[order=bottom]",
          "act": "read",
          "reads": "name",
          "expect": "2. Rotate right",
          "named": "and the turn is in the history"
        },
        {
          "locator": "Button#FitButton",
          "act": "press",
          "with": "Ctrl+Shift+R",
          "named": "Ctrl+Shift+R turns it back"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — Rotate left — 8 × 16",
          "named": "upright again, as a third version"
        },
        {
          "locator": "Button#UndoButton",
          "act": "invoke",
          "named": "the left turn is undone"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — Rotate right — 16 × 8",
          "named": "back to the right turn"
        },
        {
          "locator": "Button#FitButton",
          "act": "press",
          "with": "Ctrl+R",
          "named": "Ctrl+R turns it right again"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — Rotate right — 8 × 16",
          "named": "a half turn from the opened photo"
        }
      ]
    },

    {
      // PB66: the mirrored pixels are ImageTransformsTests'; this is the toolbar and the history.
      "name": "the photo is flipped both ways from the toolbar, each flip a version that undoes",
      "catches": "a flip button that does nothing, changes the photo's size, or flips without a history entry to undo",
      "filed": "PB66",
      "tags": ["toolbar", "edit", "history"],
      "fixture": "a window on the rotated JPEG fixture, to edit",
      "steps": [
        {
          "locator": "Button#FlipHorizontalButton",
          "act": "invoke",
          "named": "Flip horizontal is pressed"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — Flip horizontal — 8 × 16",
          "named": "the photo keeps its size, as a new version"
        },
        {
          "locator": "Button#FlipVerticalButton",
          "act": "invoke",
          "named": "Flip vertical is pressed"
        },
        {
          "locator": "List#History > ListItem[order=bottom]",
          "act": "read",
          "reads": "name",
          "expect": "3. Flip vertical",
          "named": "both flips are in the history"
        },
        {
          "locator": "Button#UndoButton",
          "act": "invoke",
          "named": "the vertical flip is undone"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — Flip horizontal — 8 × 16",
          "named": "back to the horizontal flip"
        }
      ]
    },

    {
      // PB67: the rectangle is set through the surface's text value, since winwright cannot drag
      // a handle from one point of the surface to another (WW572); CropMathTests holds the drag.
      "name": "the photo is cropped to a rectangle and an aspect, as a version that undoes",
      "catches": "a crop editor that does not open, an aspect or size the bar does not report, or an Apply that cuts the wrong pixels or nothing",
      "filed": "PB67",
      "tags": ["toolbar", "edit", "crop", "history"],
      "fixture": "a window on the rotated JPEG fixture, to edit",
      "steps": [
        {
          "locator": "Button#CropButton",
          "act": "invoke",
          "named": "Crop is pressed"
        },
        {
          "locator": "Text#CropSize",
          "act": "read",
          "reads": "name",
          "expect": "8 × 16 px",
          "named": "the editor starts on the whole 8 x 16 photo"
        },
        {
          "locator": "ComboBox#CropAspect",
          "act": "expand",
          "named": "the aspects are opened"
        },
        {
          "locator": "ComboBox#CropAspect > ListItem[name=\"1:1\"]",
          "act": "select",
          "reads": "selected",
          "expect": "selected",
          "named": "1:1 is chosen"
        },
        {
          "locator": "Text#CropSize",
          "act": "read",
          "reads": "name",
          "expect": "8 × 8 px",
          "named": "the largest square fits the photo's width"
        },
        {
          "locator": "Slider#Surface",
          "act": "set value",
          "with": "2,4,4,8",
          "named": "the rectangle is set to 4 x 8 from (2, 4)"
        },
        {
          "locator": "Text#CropSize",
          "act": "read",
          "reads": "name",
          "expect": "4 × 8 px",
          "named": "the bar follows the rectangle"
        },
        {
          "locator": "Button#CropApply",
          "act": "invoke",
          "named": "Apply is pressed"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — Crop 4 × 8 — 4 × 8",
          "named": "the photo is now the 4 x 8 rectangle, as a new version"
        },
        {
          "locator": "Button#CropApply",
          "act": "read",
          "absent": true,
          "named": "and the editor has closed"
        },
        {
          "locator": "Button#UndoButton",
          "act": "invoke",
          "named": "the crop is undone"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — 8 × 16",
          "named": "the whole photo is back"
        }
      ]
    },

    {
      // PB13, PB58: only the offer is read; the download itself needs the network, which a case
      // does not reach, and ModelDownloadsTests drives it against a stand-in server.
      "name": "with no models the Models panel offers to download everything",
      "catches": "a Models panel that hides the downloads, or offers them disabled",
      "filed": "PB13, PB75",
      "tags": ["models", "download"],
      "fixture": "a window with a photo open and no models",
      "steps": [
        {
          "locator": "Button#ModelsButton",
          "act": "invoke",
          "named": "the Models panel is opened"
        },
        {
          "locator": "Text#DownloadNote",
          "act": "read",
          "reads": "name",
          "matches": "^Restore faces and Remove background download their models the first time you use them\\. To work offline from the start, download everything now: \\d+ MB, the high-quality \\(FP32\\) models included\\.",
          "named": "it says what downloads on first use, and what everything takes"
        },
        {
          "locator": "Button#DownloadModelsButton",
          "act": "read",
          "reads": "enabled",
          "expect": "enabled",
          "named": "and offers it"
        },
        {
          "locator": "Button#ModelsClose",
          "act": "invoke",
          "named": "the Models panel is closed"
        }
      ]
    },

    {
      // PB57: choose file types the name and reads it back before confirming (winwright WW561).
      "name": "Save as writes the photo where the Save dialog is told",
      "catches": "a Save as whose dialog closes and writes nothing, or writes under another name",
      "filed": "PB57",
      "tags": ["export", "dialog"],
      "fixture": "a window on a staged photo, to save through the dialog",
      "steps": [
        {
          "locator": "Button#SaveButton",
          "act": "invoke",
          "named": "Save as is pressed"
        },
        {
          "locator": "Window[class=\"#32770\"]",
          "act": "choose file",
          "with": "{files}/saved.png",
          "named": "the dialog is told to save saved.png in the staged folder"
        },
        {
          "locator": "Window[class=\"#32770\"]",
          "act": "read",
          "absent": true,
          "named": "the dialog closed"
        },
        {
          "locator": "Text#ExportStatus",
          "act": "read",
          "reads": "name",
          "expect": "Saved saved.png",
          "named": "the export card says it saved saved.png"
        }
      ]
    },

    {
      "name": "--open shows the photo upright with its name and size",
      "catches": "an open that ignores EXIF orientation, shows nothing, or reports the wrong size",
      "filed": "PB23",
      "tags": ["open"],
      "fixture": "a window opened on the rotated JPEG fixture",
      "steps": [
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — 8 × 16",
          "named": "the caption names the file and its upright size"
        },
        {
          // PB27: the photo is in the GPU surface, which publishes its state as item status.
          "locator": "Slider#Surface",
          "act": "read",
          "reads": "status",
          "matches": "^zoom 1x, Single",
          "named": "the photo is on the surface, fitted, not compared"
        },
        {
          // PB27: comparing needs a result, so here it is off; the tiny-model case (PB42) turns it on.
          "locator": "RadioButton#ModeDivider",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and there is nothing to compare it with yet"
        }
      ]
    },

    {
      // The run itself is cases/upscale.cases.json's, on PB42's tiny models.
      "name": "with no models the operations panel says which one is missing",
      "catches": "an Upscale button that starts a run doomed to fail, or a panel that hides why it cannot run",
      "filed": "PB24",
      "tags": ["operations"],
      "fixture": "a window with a photo open and no models",
      "steps": [
        {
          "locator": "Text#OperationNote",
          "act": "read",
          "reads": "name",
          "matches": "^realesrgan-x4plus \\(fp16\\) is not in .*Download the models first\\.$",
          "named": "the note names the 4x model and its variant"
        },
        {
          "locator": "Button#UpscaleButton",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and the upscale button cannot start a run"
        },
        {
          // PB29: no FP32 set on disk, so High quality is not offered yet.
          "locator": "RadioButton#QualityHigh",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "High quality cannot be chosen"
        },
        {
          "locator": "Text#QualityNote",
          "act": "read",
          "reads": "name",
          "expect": "High quality needs the FP32 models: download them in Models.",
          "named": "and the note says where to get it"
        }
      ]
    },

    {
      // PB60: a 4x of an 8192 px photo overflowed and closed the app; now it is refused up front.
      "name": "an upscale too large to hold is refused with the size it would have",
      "catches": "an Upscale button that starts a run past what memory and an array can hold, or a refusal that does not say what to choose instead",
      "filed": "PB60",
      "tags": ["operations"],
      "fixture": "a window with a 4100 px photo open",
      "steps": [
        {
          "locator": "Text#OperationNote",
          "act": "read",
          "reads": "name",
          "expect": "4× would make this photo 16400 × 16400, past the 16384 × 16384 Revelei can hold. Choose 2×, or a smaller photo.",
          "named": "the note gives the size 4x would make and what to choose"
        },
        {
          "locator": "Button#UpscaleButton",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and the button cannot start it"
        },
        {
          "locator": "RadioButton#Scale2",
          "act": "select",
          "reads": "selected",
          "expect": "selected",
          "named": "2x is chosen"
        },
        {
          // No models in this folder, so what is left to say is the missing model, not the size.
          "locator": "Text#OperationNote",

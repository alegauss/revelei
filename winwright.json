{
  // PB38: what is true of this project rather than of any one case, for winwright. Every relative
  // path resolves against this file's directory, so a case carries no path and runs on any checkout.

  // The app's output under its RID: Revelei.App sets win-x64 unconditionally. {configuration}
  // is the build under test (WW521): CasesRun passes its own, and Debug is what run-tests.cmd builds.
  "executable": "src/Revelei.App/bin/{configuration}/net10.0-windows10.0.19041.0/win-x64/Revelei.exe",
  "configuration": "Debug",

  "sourceRoot": "src",

  "timeouts": {
    // The window shows before provider detection starts, so a launch past a few seconds is itself
    // a finding; ten still fails a hang rather than waiting on it.
    "launch": 10000,
    // Long enough for the probe session (PB14) to report the provider, which took 1.5 s here.
    "resolve": 8000,
    "act": 5000,
    "poll": 25,
    "stop": 5000
  }
}

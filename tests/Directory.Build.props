<Project>

  <!-- Inherits the repository's own gates, then adds what only a test project needs. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The app's and Revelei.Inference's, which Windows ML sets (PB43). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- The app's RID, so ONNX Runtime's natives sit beside the test exe as they do beside the app's.
         Under runtimes\ only .NET finds them: Windows ML's native DLL asks Windows for onnxruntime.dll
         by name, and Windows 11 answers with System32's 1.17, which cannot run this ORT. The folder
         stays bin\<config>\<tfm>\, which run-tests.cmd reads. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>

    <!-- xunit.v3's own console runner does not speak the protocol `dotnet test` uses and reports
         "zero tests ran" on a suite that passes. This switches both to Microsoft.Testing.Platform,
         so run-tests.cmd, `dotnet test` and the assembly launched directly agree. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <!-- A test that never returns is ended by run-tests.cmd's timeout and named, rather than
         holding the run with nothing said. -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
  </ItemGroup>

  <!-- The repository's root, found once rather than walked to by a copy in every class. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Repository.cs" Link="Repository.cs" />
    <Using Include="Revelei.Tests" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- PB38: the driving half of the UI cases in ..\..\cases, as winwright's adoption guide and
       quickshell set it up. One package reference and nothing else: no reference to the app or to
       WPF, so a case asserts against what a user launches, not against types it was compiled with.
       The app under test is launched by the path winwright.json spells, {configuration} filled with
       this build's (WW521). -->
  <PropertyGroup>
    <RootNamespace>Revelei.Cases</RootNamespace>
    <!-- A Winwright version the feed does not have must fail the restore, not resolve to another. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Winwright" Version="1.1.5" />
  </ItemGroup>

</Project>

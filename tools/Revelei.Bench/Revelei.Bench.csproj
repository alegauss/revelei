<Project Sdk="Microsoft.NET.Sdk">

  <!-- PB34: the FP16 against FP32 table in the README, measured through the app's own pipelines on
       each provider this desk has. A tool, not a test: it needs the exported models and takes
       minutes, so run-tests.cmd only builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Revelei.Bench</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Revelei.Imaging\Revelei.Imaging.csproj" />
    <ProjectReference Include="..\..\src\Revelei.Inference\Revelei.Inference.csproj" />
  </ItemGroup>

</Project>

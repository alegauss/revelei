<Project Sdk="Microsoft.NET.Sdk">

  <!-- ONNX Runtime: provider detection, sessions loaded on demand and the one-at-a-time queue.
       It reads tensors from Imaging and never sees a UI type. -->
  <PropertyGroup>
    <!-- Windows 10 19041: what Windows ML's WinRT projection needs to activate reg-free, unpackaged. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Revelei.Inference</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PB43 (spike/onnx-runtime/README.md): Windows ML without the Windows App SDK. It carries its
         own ONNX Runtime with DirectML, which stays the provider wherever Windows ML has nothing
         better, and adds the TensorRT-RTX and OpenVINO providers Windows Update installs. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" />
    <!-- Only to list adapters and their video memory; rendering stays in Revelei.Render. -->
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Revelei.Imaging\Revelei.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PB58: the pinned manifest publish-models.py wrote, so sizes and hashes are known offline. -->
    <EmbeddedResource Include="models-manifest.json" LogicalName="Revelei.Inference.models-manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests write ProbeModel to disk to load a real session without a downloaded model. -->
    <InternalsVisibleTo Include="Revelei.Inference.Tests" />
  </ItemGroup>

</Project>

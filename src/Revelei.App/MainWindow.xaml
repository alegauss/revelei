<Window x:Class="Revelei.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:Revelei.Render;assembly=Revelei.Render"
        xmlns:local="clr-namespace:Revelei.App"
        Title="Revelei"
        Icon="pack://application:,,,/Revelei.ico"
        Width="1100"
        Height="720"
        FontFamily="{StaticResource AppFont}"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        PreviewKeyDown="OnWindowKeyDown"
        WindowStartupLocation="CenterScreen">
  <!-- PB28: undo and redo through the application commands, which bring Ctrl+Z and Ctrl+Y;
       Ctrl+Shift+Z is the other redo people reach for. -->
  <!-- PB63: the toolbar's Open (Ctrl+O, the command's own) and Save as (Ctrl+S, bound here, since
       SaveAs has no gesture of its own) are commands too, so the button and the key share one
       CanExecute. -->
  <Window.CommandBindings>
    <CommandBinding Command="Open" Executed="OnOpenCommand" CanExecute="CanOpen" />
    <CommandBinding Command="SaveAs" Executed="OnSaveAs" CanExecute="CanSaveAs" />
    <CommandBinding Command="Undo" Executed="OnUndo" CanExecute="CanUndo" />
    <CommandBinding Command="Redo" Executed="OnRedo" CanExecute="CanRedo" />
    <!-- PB65: the quarter turns, whose commands carry Ctrl+R and Ctrl+Shift+R. -->
    <CommandBinding Command="{x:Static local:MainWindow.RotateLeftCommand}" Executed="OnRotateLeft" CanExecute="CanEdit" />
    <CommandBinding Command="{x:Static local:MainWindow.RotateRightCommand}" Executed="OnRotateRight" CanExecute="CanEdit" />
    <CommandBinding Command="{x:Static local:MainWindow.CropCommand}" Executed="OnCrop" CanExecute="CanCrop" />
    <!-- PB66: the flips. -->
    <CommandBinding Command="{x:Static local:MainWindow.FlipHorizontalCommand}" Executed="OnFlipHorizontal" CanExecute="CanEdit" />
    <CommandBinding Command="{x:Static local:MainWindow.FlipVerticalCommand}" Executed="OnFlipVertical" CanExecute="CanEdit" />
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Command="SaveAs" Key="S" Modifiers="Ctrl" />
    <KeyBinding Command="Redo" Key="Z" Modifiers="Ctrl+Shift" />
  </Window.InputBindings>
  <DockPanel>
    <!-- PB14: where inference runs, so a slow upscale on CPU is never a mystery. A chip that
         carries the word, per the design rules in Styles.xaml. -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <Border Style="{StaticResource StatusChip}">
          <TextBlock x:Name="ProviderStatus" AutomationProperties.AutomationId="ProviderStatus" Text="Detecting GPU…" />
        </Border>
      </StatusBarItem>
      <!-- PB24: the last run's wall time and provider, from its OperationRecord (PB22). -->
      <StatusBarItem>
        <Border x:Name="LastRunChip" Style="{StaticResource StatusChip}" Visibility="Collapsed">
          <TextBlock x:Name="LastRun" AutomationProperties.AutomationId="LastRun" />
        </Border>
      </StatusBarItem>
      <!-- PB60: the run in progress, seen from anywhere, About and the download offer included. -->
      <StatusBarItem>
        <Border x:Name="JobChip" Style="{StaticResource StatusChip}" Visibility="Collapsed">
          <TextBlock x:Name="JobChipText" AutomationProperties.AutomationId="JobChip">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0}: {1}">
                <Binding ElementName="JobTitle" Path="Text" />
                <Binding ElementName="JobStatus" Path="Text" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </Border>
      </StatusBarItem>
      <!-- PB58: a model download in progress, wherever the card that started it has scrolled to. -->
      <StatusBarItem>
        <Border x:Name="DownloadChip" Style="{StaticResource StatusChip}" Visibility="Collapsed">
          <TextBlock x:Name="DownloadChipText" AutomationProperties.AutomationId="DownloadChip" />
        </Border>
      </StatusBarItem>
      <!-- PB46: the version, each model's license and the third-party notices. -->
      <!-- PB75: the Models panel, every catalog model as a card. -->
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <!-- PB80: the Create screen, a prompt to an image. -->
          <Button x:Name="CreateButton" AutomationProperties.AutomationId="CreateButton" Content="Create" Padding="10,2" Margin="0,0,6,0" Click="OnCreateClick" />
          <Button x:Name="ModelsButton" AutomationProperties.AutomationId="ModelsButton" Content="Models" Padding="10,2" Margin="0,0,6,0" Click="OnModelsClick" />
          <Button x:Name="AboutButton" AutomationProperties.AutomationId="AboutButton" Content="About" Padding="10,2" Click="OnAboutClick" />
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <!-- PB63: the toolbar, beside how the shown version is compared (PB27), which shows with
         the photo. It spans the window, the operations panel's width included, so the edits
         fit beside the comparison on a small screen, and it goes while About or a download
         offer takes the stage's place (PB65). Its groups, in order: Open and Save as; Undo and Redo; rotate and flip
         (PB65, PB66); Crop (PB67); Invert colours (PB68). Each button is a glyph with an
         accessible name, a tooltip naming its shortcut and an AutomationId; what needs a
         photo is off without one, and an edit waits for a running operation as Undo does,
         each landing as a version in the history (PB28). A WPF ToolBar moves what does not
         fit into its overflow menu rather than clipping it; no case narrows the window to
         read that, since winwright has no resize (WW570). -->
    <DockPanel DockPanel.Dock="Top" Margin="24,16,24,0"
               Visibility="{Binding Visibility, ElementName=Stage}">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                  Visibility="{Binding Visibility, ElementName=Viewer}">
        <RadioButton x:Name="ModeSingle" AutomationProperties.AutomationId="ModeSingle" Content="Result"
                     GroupName="Compare" IsChecked="True" Margin="0,0,12,0" Checked="OnModeChanged" />
        <RadioButton x:Name="ModeDivider" AutomationProperties.AutomationId="ModeDivider" Content="Compare"
                     GroupName="Compare" Margin="0,0,12,0" Checked="OnModeChanged" />
        <RadioButton x:Name="ModeSideBySide" AutomationProperties.AutomationId="ModeSideBySide" Content="Side by side"
                     GroupName="Compare" Margin="0,0,12,0" Checked="OnModeChanged" />
        <Button x:Name="FitButton" AutomationProperties.AutomationId="FitButton" Content="Fit" Padding="10,2"
                Click="OnFitClick" ToolTip="Show the whole image" />
      </StackPanel>
      <ToolBarTray Background="Transparent" IsLocked="True" Margin="0,0,12,0">
        <ToolBar x:Name="EditorToolbar" AutomationProperties.AutomationId="EditorToolbar" AutomationProperties.Name="Editor"
                 Background="Transparent">
          <Button x:Name="ToolbarOpen" AutomationProperties.AutomationId="ToolbarOpen" AutomationProperties.Name="Open"
                  Command="Open" ToolTip="Open a photo (Ctrl+O)">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8E5;" />
          </Button>
          <Button x:Name="ToolbarSaveAs" AutomationProperties.AutomationId="ToolbarSaveAs" AutomationProperties.Name="Save as"
                  Command="SaveAs" ToolTip="Save as (Ctrl+S)">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE792;" />
          </Button>
          <Separator />
          <Button x:Name="UndoButton" AutomationProperties.AutomationId="UndoButton" AutomationProperties.Name="Undo"
                  Command="Undo" ToolTip="Undo (Ctrl+Z)">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7A7;" />
          </Button>
          <Button x:Name="RedoButton" AutomationProperties.AutomationId="RedoButton" AutomationProperties.Name="Redo"
                  Command="Redo" ToolTip="Redo (Ctrl+Y)">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7A6;" />
          </Button>
          <Separator />
          <!-- PB65: the font has one rotate glyph, clockwise; mirrored, it turns the other way. -->
          <Button x:Name="RotateLeftButton" AutomationProperties.AutomationId="RotateLeftButton" AutomationProperties.Name="Rotate left"
                  Command="{x:Static local:MainWindow.RotateLeftCommand}" ToolTip="Rotate left (Ctrl+Shift+R)">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <ScaleTransform ScaleX="-1" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Button>
          <Button x:Name="RotateRightButton" AutomationProperties.AutomationId="RotateRightButton" AutomationProperties.Name="Rotate right"
                  Command="{x:Static local:MainWindow.RotateRightCommand}" ToolTip="Rotate right (Ctrl+R)">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7AD;" />
          </Button>
          <!-- PB66: the font's two-way arrows, upright for the vertical flip. -->
          <Button x:Name="FlipHorizontalButton" AutomationProperties.AutomationId="FlipHorizontalButton" AutomationProperties.Name="Flip horizontal"
                  Command="{x:Static local:MainWindow.FlipHorizontalCommand}" ToolTip="Flip horizontal">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8AB;" />
          </Button>
          <Button x:Name="FlipVerticalButton" AutomationProperties.AutomationId="FlipVerticalButton" AutomationProperties.Name="Flip vertical"
                  Command="{x:Static local:MainWindow.FlipVerticalCommand}" ToolTip="Flip vertical">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8AB;" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform>
                <RotateTransform Angle="90" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Button>
          <Separator />
          <!-- PB67: a toggle, so pressing it again while cropping is the same as Cancel. -->
          <Button x:Name="CropButton" AutomationProperties.AutomationId="CropButton" AutomationProperties.Name="Crop"
                  Command="{x:Static local:MainWindow.CropCommand}" ToolTip="Crop (C)">
            <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE7A8;" />
          </Button>
        </ToolBar>
      </ToolBarTray>
    </DockPanel>

    <!-- PB24: the operations panel: upscale, denoise (PB36), face restore (PB31) and background
         removal (PB32). Shown once an image is open. -->
    <DockPanel x:Name="Operations" DockPanel.Dock="Right" Width="300" Margin="0,8,24,24" Visibility="Collapsed">
      <TextBlock DockPanel.Dock="Top" Text="Operations" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
      <!-- PB60: the run in progress, pinned above the cards rather than below them, so its
           progress and its end are seen without scrolling a panel taller than the window. -->
      <Border x:Name="JobPanel" DockPanel.Dock="Top" Style="{StaticResource GroupCard}" Padding="16" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel>
          <DockPanel>
            <Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" DockPanel.Dock="Right" Content="Cancel"
                    Padding="12,2" Click="OnCancelClick" />
            <TextBlock x:Name="JobTitle" AutomationProperties.AutomationId="JobTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ProgressBar x:Name="JobProgress" AutomationProperties.AutomationId="JobProgress" Height="6" Minimum="0" Margin="0,10,0,0" />
          <TextBlock x:Name="JobStatus" AutomationProperties.AutomationId="JobStatus" Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    <ScrollViewer x:Name="OperationsScroll" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- PB29: every operation runs the bundled FP16 set or the downloaded FP32 one. -->
        <Border Style="{StaticResource GroupCard}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Quality" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <RadioButton x:Name="QualityStandard" AutomationProperties.AutomationId="QualityStandard" GroupName="Quality"
                         Content="Standard" IsChecked="True" Margin="0,0,0,4" Checked="OnQualityChanged" />
            <RadioButton x:Name="QualityHigh" AutomationProperties.AutomationId="QualityHigh" GroupName="Quality"
                         Content="High quality" Checked="OnQualityChanged" />
            <TextBlock x:Name="QualityNote" AutomationProperties.AutomationId="QualityNote"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource GroupCard}" Padding="16">
          <StackPanel>
            <TextBlock Text="Upscale" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Real-ESRGAN, enlarging and restoring detail" Style="{StaticResource StatCaption}" Margin="0,2,0,12" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <RadioButton x:Name="Scale2" AutomationProperties.AutomationId="Scale2" Content="2×" GroupName="Scale" Margin="0,0,16,0" />
              <RadioButton x:Name="Scale4" AutomationProperties.AutomationId="Scale4" Content="4×" GroupName="Scale" IsChecked="True" />
            </StackPanel>
            <Button x:Name="UpscaleButton" AutomationProperties.AutomationId="UpscaleButton" Content="Upscale"
                    HorizontalAlignment="Stretch" Padding="12,6" Click="OnUpscaleClick" IsEnabled="False" />
            <TextBlock x:Name="OperationNote" AutomationProperties.AutomationId="OperationNote" Visibility="Collapsed"
                       Style="{StaticResource StatCaption}" Margin="0,10,0,0" />
          </StackPanel>
        </Border>

        <!-- PB36: SCUNet over tiles, the same size out. -->
        <Border Style="{StaticResource GroupCard}" Padding="16" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Denoise" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="SCUNet, removing the grain of a dark or high-ISO photo" Style="{StaticResource StatCaption}"
                       TextWrapping="Wrap" Margin="0,2,0,12" />
            <Button x:Name="DenoiseButton" AutomationProperties.AutomationId="DenoiseButton" Content="Denoise"
                    HorizontalAlignment="Stretch" Padding="12,6" Click="OnDenoiseClick" IsEnabled="False" />
            <TextBlock x:Name="DenoiseNote" AutomationProperties.AutomationId="DenoiseNote" Visibility="Collapsed"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,10,0,0" />
          </StackPanel>
        </Border>

        <!-- PB31: GFPGAN on every face YuNet finds, blended by strength, after an optional upscale
             at the factor the Upscale card has chosen. -->
        <Border Style="{StaticResource GroupCard}" Padding="16" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Restore faces" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="GFPGAN, finding and sharpening each face" Style="{StaticResource StatCaption}" Margin="0,2,0,12" />
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Strength" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding Value, ElementName=FaceStrength, StringFormat={}{0:0}%}" />
              <Slider x:Name="FaceStrength" AutomationProperties.AutomationId="FaceStrength" AutomationProperties.Name="Strength"
                      Minimum="0" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="5" />
            </DockPanel>
            <CheckBox x:Name="FaceUpscale" AutomationProperties.AutomationId="FaceUpscale" Margin="0,0,0,12"
                      Content="Upscale first, by the factor above" Checked="OnFaceOptionChanged" Unchecked="OnFaceOptionChanged" />
            <!-- PB58: GFPGAN is not in the installer; its first use downloads it, and this says what,
                 how large and from where, then how far the download is. -->
            <StackPanel x:Name="FaceFirstUse" Margin="0,0,0,12" Visibility="Collapsed">
              <Border x:Name="FaceFirstUseChip" Style="{StaticResource StatusChip}" HorizontalAlignment="Left">
                <TextBlock x:Name="FaceFirstUseBadge" AutomationProperties.AutomationId="FaceFirstUseBadge" />
              </Border>
              <TextBlock x:Name="FaceFirstUseDetail" AutomationProperties.AutomationId="FaceFirstUseDetail"
                         Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <ProgressBar x:Name="FaceFirstUseProgress" AutomationProperties.AutomationId="FaceFirstUseProgress"
                           Height="6" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed" />
              <Button x:Name="FaceFirstUseAction" AutomationProperties.AutomationId="FaceFirstUseAction"
                      HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0" Visibility="Collapsed" Click="OnFirstUseActionClick" />
            </StackPanel>
            <Button x:Name="RestoreFacesButton" AutomationProperties.AutomationId="RestoreFacesButton" Content="Restore faces"
                    HorizontalAlignment="Stretch" Padding="12,6" Click="OnRestoreFacesClick" IsEnabled="False" />
            <TextBlock x:Name="FaceNote" AutomationProperties.AutomationId="FaceNote" Visibility="Collapsed"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock x:Name="FaceLicence" AutomationProperties.AutomationId="FaceLicence"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="GFPGAN's StyleGAN2 and DFDNet parts are under non-commercial licences: research or evaluation use only." />
          </StackPanel>
        </Border>

        <!-- PB32: RMBG-1.4's mask as the image's alpha; export as PNG or WebP keeps it. -->
        <Border Style="{StaticResource GroupCard}" Padding="16" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Remove background" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="RMBG-1.4, making everything but the subject transparent" Style="{StaticResource StatCaption}"
                       TextWrapping="Wrap" Margin="0,2,0,12" />
            <!-- PB47: the mask refined against the full-size photo; off gives BRIA's own result to compare. -->
            <CheckBox x:Name="RefineEdges" AutomationProperties.AutomationId="RefineEdges" IsChecked="True" Margin="0,0,0,12"
                      Content="Refine edges against the photo" />
            <!-- PB58: RMBG-1.4 and ViTMatte are fetched on first use, as on the Restore faces card. -->
            <StackPanel x:Name="BackgroundFirstUse" Margin="0,0,0,12" Visibility="Collapsed">
              <Border x:Name="BackgroundFirstUseChip" Style="{StaticResource StatusChip}" HorizontalAlignment="Left">
                <TextBlock x:Name="BackgroundFirstUseBadge" AutomationProperties.AutomationId="BackgroundFirstUseBadge" />
              </Border>
              <TextBlock x:Name="BackgroundFirstUseDetail" AutomationProperties.AutomationId="BackgroundFirstUseDetail"
                         Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <ProgressBar x:Name="BackgroundFirstUseProgress" AutomationProperties.AutomationId="BackgroundFirstUseProgress"
                           Height="6" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed" />
              <Button x:Name="BackgroundFirstUseAction" AutomationProperties.AutomationId="BackgroundFirstUseAction"
                      HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0" Visibility="Collapsed" Click="OnFirstUseActionClick" />
            </StackPanel>
            <Button x:Name="RemoveBackgroundButton" AutomationProperties.AutomationId="RemoveBackgroundButton" Content="Remove background"
                    HorizontalAlignment="Stretch" Padding="12,6" Click="OnRemoveBackgroundClick" IsEnabled="False" />
            <TextBlock x:Name="BackgroundNote" AutomationProperties.AutomationId="BackgroundNote" Visibility="Collapsed"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock x:Name="BackgroundLicence" AutomationProperties.AutomationId="BackgroundLicence"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="RMBG-1.4 is licensed by BRIA for non-commercial use; commercial use needs a license from BRIA." />
          </StackPanel>
        </Border>

        <!-- PB28: every version this image went through; the toolbar's undo and redo (PB63) move
             through them. -->
        <Border Style="{StaticResource GroupCard}" Padding="16" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="History" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ListBox x:Name="HistoryList" AutomationProperties.AutomationId="History" AutomationProperties.Name="History"
                     MaxHeight="160" IsHitTestVisible="False" BorderThickness="0" />
          </StackPanel>
        </Border>

        <!-- PB25: export the current version. -->
        <Border Style="{StaticResource GroupCard}" Padding="16" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="Export" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ComboBox x:Name="ExportFormat" AutomationProperties.AutomationId="ExportFormat"
                      AutomationProperties.Name="Format" SelectedIndex="0" SelectionChanged="OnExportOptionChanged">
              <ComboBoxItem Content="PNG" />
              <ComboBoxItem Content="JPEG" />
              <ComboBoxItem Content="WebP" />
            </ComboBox>
            <DockPanel x:Name="QualityRow" Margin="0,10,0,0" Visibility="Collapsed">
              <TextBlock x:Name="QualityValue" DockPanel.Dock="Right" Width="28" TextAlignment="Right"
                         Text="{Binding Value, ElementName=ExportQuality, StringFormat={}{0:0}}" />
              <Slider x:Name="ExportQuality" AutomationProperties.AutomationId="ExportQuality" AutomationProperties.Name="Quality"
                      Minimum="1" Maximum="100" Value="92" IsSnapToTickEnabled="True" TickFrequency="1" />
            </DockPanel>
            <StackPanel x:Name="TransparencyRow" Margin="0,10,0,0" Visibility="Collapsed">
              <TextBlock x:Name="TransparencyWarning" AutomationProperties.AutomationId="TransparencyWarning"
                         Style="{StaticResource StatCaption}"
                         Text="JPEG has no transparency: transparent pixels are filled with the background below." />
              <ComboBox x:Name="ExportBackground" AutomationProperties.AutomationId="ExportBackground"
                        AutomationProperties.Name="Background" SelectedIndex="0" Margin="0,6,0,0">
                <ComboBoxItem Content="White" />
                <ComboBoxItem Content="Black" />
              </ComboBox>
            </StackPanel>
            <!-- PB45: off by default, since GPS leaving with a shared photo is the risk. -->
            <CheckBox x:Name="KeepMetadata" AutomationProperties.AutomationId="KeepMetadata" Margin="0,10,0,0"
                      Content="Keep camera details (date, camera, GPS)" Checked="OnExportOptionChanged" Unchecked="OnExportOptionChanged" />
            <TextBlock x:Name="MetadataNote" AutomationProperties.AutomationId="MetadataNote" Visibility="Collapsed"
                       Style="{StaticResource StatCaption}" Text="Only JPEG keeps camera details; PNG and WebP are saved without them." />
            <Button x:Name="SaveButton" AutomationProperties.AutomationId="SaveButton" Content="Save as…"
                    HorizontalAlignment="Stretch" Padding="12,6" Margin="0,12,0,0" Command="SaveAs" />
            <TextBlock x:Name="ExportStatus" AutomationProperties.AutomationId="ExportStatus" Visibility="Collapsed"
                       Style="{StaticResource StatCaption}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
    </DockPanel>

    <!-- PB23: the open screen. A drop zone and a button until an image is open, then the image.
         PB46: the About panel takes the stage's place while open, since nothing WPF draws can lie
         over the image surface's own window. -->
    <Grid Margin="24,8,24,24">
     <DockPanel x:Name="Stage">

     <Grid>
      <Border x:Name="DropZone" AutomationProperties.AutomationId="DropZone" Style="{StaticResource GroupCard}"
              Padding="48" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="Drop a photo here" Style="{StaticResource StatValue}" HorizontalAlignment="Center" />
          <TextBlock Text="PNG, JPG, WebP, TIFF and whatever else Windows can open" Style="{StaticResource StatCaption}"
                     HorizontalAlignment="Center" Margin="0,6,0,20" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="OpenButton" AutomationProperties.AutomationId="OpenButton" Content="Open image…"
                    Padding="16,6" Click="OnOpenClick" />
            <!-- PB80: or create one from a sentence. -->
            <Button x:Name="DropZoneCreate" AutomationProperties.AutomationId="DropZoneCreate" Content="Create one…"
                    Padding="16,6" Margin="8,0,0,0" Click="OnCreateClick" />
          </StackPanel>
          <TextBlock x:Name="OpenError" AutomationProperties.AutomationId="OpenError" Visibility="Collapsed"
                     Margin="0,16,0,0" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>
      </Border>

      <DockPanel x:Name="Viewer" Visibility="Collapsed">
        <!-- PB27: the caption; how it is compared sits beside the toolbar above (PB63). -->
        <TextBlock x:Name="ImageInfo" DockPanel.Dock="Top" AutomationProperties.AutomationId="ImageInfo"
                   Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
        <!-- PB67: the crop editor's bar, above the photo since nothing WPF draws can lie over the
             surface: the aspect, the rectangle's size in the photo's own pixels, Apply (Enter)
             and Cancel (Esc). -->
        <Border x:Name="CropBar" DockPanel.Dock="Top" Style="{StaticResource GroupCard}" Padding="12,8" Margin="0,0,0,8"
                Visibility="Collapsed">
          <DockPanel>
            <Button x:Name="CropCancel" AutomationProperties.AutomationId="CropCancel" DockPanel.Dock="Right" Content="Cancel"
                    Padding="12,2" Margin="8,0,0,0" IsCancel="True" Click="OnCropCancel" />
            <Button x:Name="CropApply" AutomationProperties.AutomationId="CropApply" DockPanel.Dock="Right" Content="Apply"
                    Padding="12,2" IsDefault="True" Click="OnCropApply" />
            <TextBlock Text="Aspect" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CropAspect" AutomationProperties.AutomationId="CropAspect" AutomationProperties.Name="Aspect"
                      Width="110" SelectedIndex="0" SelectionChanged="OnCropAspectChanged">
              <ComboBoxItem Content="Free" />
              <ComboBoxItem Content="Original" />
              <ComboBoxItem Content="1:1" />
              <ComboBoxItem Content="4:3" />
              <ComboBoxItem Content="3:4" />
              <ComboBoxItem Content="3:2" />
              <ComboBoxItem Content="2:3" />
              <ComboBoxItem Content="16:9" />
              <ComboBoxItem Content="9:16" />
            </ComboBox>
            <TextBlock x:Name="CropSize" AutomationProperties.AutomationId="CropSize" VerticalAlignment="Center" Margin="12,0,0,0" />
          </DockPanel>
        </Border>
        <!-- PB64: a later file that could not be opened, said over the photo, which stays. -->
        <TextBlock x:Name="ViewerOpenError" DockPanel.Dock="Top" AutomationProperties.AutomationId="ViewerOpenError"
                   Visibility="Collapsed" TextWrapping="Wrap" Margin="2,0,0,8"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <!-- The GPU surface (PB40's path): wheel to zoom, drag to pan, drag the divider to compare. -->
        <render:ImageSurface x:Name="Surface" AutomationProperties.AutomationId="Surface" />
      </DockPanel>
     </Grid>
     </DockPanel>

      <ScrollViewer x:Name="AboutPanel" AutomationProperties.AutomationId="AboutPanel" Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource GroupCard}" Padding="24" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Top">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <Button x:Name="AboutClose" AutomationProperties.AutomationId="AboutClose" DockPanel.Dock="Right"
                      Content="Close" Padding="12,4" Click="OnAboutClick" />
              <TextBlock Text="Revelei" Style="{StaticResource StatValue}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="AboutVersion" AutomationProperties.AutomationId="AboutVersion" Style="{StaticResource StatCaption}" />
            <TextBlock Text="Photos are processed on this computer; nothing is uploaded." Style="{StaticResource StatCaption}" Margin="0,2,0,16" />

            <TextBlock Text="Models" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <TextBlock x:Name="AboutModelsFolder" AutomationProperties.AutomationId="AboutModelsFolder"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ListBox x:Name="AboutModels" AutomationProperties.AutomationId="AboutModels" AutomationProperties.Name="Models"
                     IsHitTestVisible="False" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="GFPGAN v1.4 and RMBG-1.4 are licensed for non-commercial use only; check each license before using results commercially."
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,6,0,16" />

            <!-- PB75: the downloads moved to the Models panel; About says what is installed and opens it. -->
            <DockPanel Margin="0,0,0,16">
              <Button x:Name="AboutOpenModels" AutomationProperties.AutomationId="AboutOpenModels" DockPanel.Dock="Right"
                      Content="Manage models" Padding="12,4" Click="OnModelsClick" />
              <TextBlock x:Name="AboutInstalled" AutomationProperties.AutomationId="AboutInstalled"
                         Style="{StaticResource StatCaption}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="Third-party software" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <TextBlock x:Name="AboutNotices" AutomationProperties.AutomationId="AboutNotices"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- PB75: the Models panel takes the stage's place, as About does: every catalog model as a
           card, filterable, with its verdict, version and actions, all going through the queue. -->
      <!-- PB80: the Create screen takes the stage's place, as Models does: the settings on the
           left, the image as it forms in the centre, Generate turning into Cancel while it runs. -->
      <DockPanel x:Name="CreatePanel" AutomationProperties.AutomationId="CreatePanel" Visibility="Collapsed">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button x:Name="CreateClose" AutomationProperties.AutomationId="CreateClose" DockPanel.Dock="Right"
                  Content="Close" Padding="12,4" Click="OnCreateClick" />
          <TextBlock Text="Create" Style="{StaticResource StatValue}" VerticalAlignment="Center" />
        </DockPanel>
        <Border DockPanel.Dock="Left" Style="{StaticResource GroupCard}" Padding="16" Width="320" VerticalAlignment="Top">
          <StackPanel>
            <StackPanel x:Name="CreateNoModel" Visibility="Collapsed" Margin="0,0,0,12">
              <TextBlock x:Name="CreateNoModelText" AutomationProperties.AutomationId="CreateNoModelText" TextWrapping="Wrap"
                         Text="No image generation model is on this PC yet. The Models panel lists them, with how each runs here." />
              <!-- PB80: the model this PC runs best, offered with its size, verdict and license. -->
              <TextBlock x:Name="CreateRecommended" AutomationProperties.AutomationId="CreateRecommended" TextWrapping="Wrap"
                         Margin="0,8,0,0" Visibility="Collapsed" />
              <Button x:Name="CreateDownloadRecommended" AutomationProperties.AutomationId="CreateDownloadRecommended"
                      HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0" Visibility="Collapsed" Click="OnCreateDownloadRecommendedClick" />
              <Button x:Name="CreateOpenModels" AutomationProperties.AutomationId="CreateOpenModels" Content="Open Models"
                      HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0" Click="OnModelsClick" />
            </StackPanel>
            <TextBlock Text="Model" Style="{StaticResource StatCaption}" />
            <ComboBox x:Name="CreateModel" AutomationProperties.AutomationId="CreateModel" AutomationProperties.Name="Model"
                      DisplayMemberPath="Label" Margin="0,2,0,2" SelectionChanged="OnCreateModelChanged" />
            <TextBlock x:Name="CreateFit" AutomationProperties.AutomationId="CreateFit" Style="{StaticResource StatCaption}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Text="Prompt" Style="{StaticResource StatCaption}" />
            <TextBox x:Name="CreatePrompt" AutomationProperties.AutomationId="CreatePrompt" AutomationProperties.Name="Prompt"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                     Margin="0,2,0,10" />
            <!-- PB80: what to avoid, for a model that takes guidance above 1 and so reads one. -->
            <StackPanel x:Name="CreateNegativeRow" Visibility="Collapsed">
              <TextBlock Text="Avoid" Style="{StaticResource StatCaption}" />
              <TextBox x:Name="CreateNegative" AutomationProperties.AutomationId="CreateNegative" AutomationProperties.Name="Avoid"
                       TextWrapping="Wrap" Margin="0,2,0,10" />
            </StackPanel>
            <TextBlock Text="Shape" Style="{StaticResource StatCaption}" />
            <ComboBox x:Name="CreateAspect" AutomationProperties.AutomationId="CreateAspect" AutomationProperties.Name="Shape"
                      DisplayMemberPath="Label" Margin="0,2,0,10" />
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Steps" Style="{StaticResource StatCaption}" />
                <TextBox x:Name="CreateSteps" AutomationProperties.AutomationId="CreateSteps" AutomationProperties.Name="Steps" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Guidance" Style="{StaticResource StatCaption}" />
                <TextBox x:Name="CreateGuidance" AutomationProperties.AutomationId="CreateGuidance" AutomationProperties.Name="Guidance" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Seed" Style="{StaticResource StatCaption}" />
            <DockPanel Margin="0,2,0,4">
              <Button x:Name="CreateDice" AutomationProperties.AutomationId="CreateDice" AutomationProperties.Name="New seed"
                      DockPanel.Dock="Right" Padding="8,2" Margin="6,0,0,0" ToolTip="A new random seed" Click="OnCreateDiceClick">
                <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE8B1;" />
              </Button>
              <TextBox x:Name="CreateSeed" AutomationProperties.AutomationId="CreateSeed" AutomationProperties.Name="Seed" />
            </DockPanel>
            <CheckBox x:Name="CreateSeedLock" AutomationProperties.AutomationId="CreateSeedLock" Content="Keep this seed"
                      Margin="0,0,0,10" ToolTip="Off, each run takes a new seed" />
            <TextBlock Text="Images" Style="{StaticResource StatCaption}" />
            <ComboBox x:Name="CreateCount" AutomationProperties.AutomationId="CreateCount" AutomationProperties.Name="Images"
                      Margin="0,2,0,10" ToolTip="Each takes the next seed, so every one can be made again" />
            <Button x:Name="CreateReset" AutomationProperties.AutomationId="CreateReset" Content="Reset to the model's settings"
                    HorizontalAlignment="Left" Padding="10,2" Margin="0,0,0,14" Click="OnCreateResetClick" />
            <Button x:Name="CreateGenerate" AutomationProperties.AutomationId="CreateGenerate" Content="Generate"
                    Padding="16,6" Click="OnCreateGenerateClick" />
          </StackPanel>
        </Border>
        <DockPanel Margin="16,0,0,0">
          <!-- PB80: this session's results; choosing one shows it with its settings, which Use
               these settings copies back. -->
          <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="CreateUseSettings" AutomationProperties.AutomationId="CreateUseSettings" DockPanel.Dock="Right"
                    Content="Use these settings" Padding="10,2" VerticalAlignment="Center" IsEnabled="False" Click="OnCreateUseSettingsClick" />
            <ListBox x:Name="CreateResults" AutomationProperties.AutomationId="CreateResults" AutomationProperties.Name="This session's images"
                     Height="92" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="OnCreateResultChanged">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Image Source="{Binding Thumbnail}" Height="80" Stretch="Uniform" ToolTip="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <TextBlock x:Name="CreateStatus" AutomationProperties.AutomationId="CreateStatus" DockPanel.Dock="Bottom"
                     Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,8,0,0" />
          <Border Style="{StaticResource GroupCard}">
            <Image x:Name="CreateImage" AutomationProperties.AutomationId="CreateImage" AutomationProperties.Name="Generated image"
                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
        </DockPanel>
      </DockPanel>

      <ScrollViewer x:Name="ModelsPanel" AutomationProperties.AutomationId="ModelsPanel" Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource GroupCard}" Padding="24" MaxWidth="860" HorizontalAlignment="Center" VerticalAlignment="Top">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <Button x:Name="ModelsClose" AutomationProperties.AutomationId="ModelsClose" DockPanel.Dock="Right"
                      Content="Close" Padding="12,4" Click="OnModelsClick" />
              <TextBlock Text="Models" Style="{StaticResource StatValue}" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <RadioButton x:Name="ModelsFilterAll" AutomationProperties.AutomationId="ModelsFilterAll" Content="All" GroupName="ModelsFilter" IsChecked="True" Margin="0,0,12,0" Checked="OnModelsFilterChecked" />
              <RadioButton x:Name="ModelsFilterInstalled" AutomationProperties.AutomationId="ModelsFilterInstalled" Content="Installed" GroupName="ModelsFilter" Margin="0,0,12,0" Checked="OnModelsFilterChecked" />
              <RadioButton x:Name="ModelsFilterAvailable" AutomationProperties.AutomationId="ModelsFilterAvailable" Content="Available" GroupName="ModelsFilter" Margin="0,0,12,0" Checked="OnModelsFilterChecked" />
              <RadioButton x:Name="ModelsFilterUpdates" AutomationProperties.AutomationId="ModelsFilterUpdates" Content="Updates" GroupName="ModelsFilter" Checked="OnModelsFilterChecked" />
            </StackPanel>

            <ItemsControl x:Name="ModelCardList" AutomationProperties.AutomationId="ModelCardList" Margin="0,0,0,12">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource GroupCard}" Padding="12" Margin="0,0,0,8">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="{Binding DownloadLabel}" Padding="10,2" Margin="6,0,0,0" Tag="{Binding Name}" Visibility="{Binding DownloadVisibility}"
                                AutomationProperties.AutomationId="{Binding DownloadId}" AutomationProperties.Name="{Binding DownloadName}" Click="OnCardDownloadClick" />
                        <Button Content="{Binding PauseLabel}" Padding="10,2" Margin="6,0,0,0" Tag="{Binding Name}" Visibility="{Binding QueuedVisibility}"
                                AutomationProperties.AutomationId="{Binding PauseId}" Click="OnCardPauseClick" />
                        <Button Content="Cancel" Padding="10,2" Margin="6,0,0,0" Tag="{Binding Name}" Visibility="{Binding QueuedVisibility}"
                                AutomationProperties.AutomationId="{Binding CancelId}" Click="OnCardCancelClick" />
                        <Button Content="Remove" Padding="10,2" Margin="6,0,0,0" Tag="{Binding Name}" Visibility="{Binding RemoveVisibility}"
                                AutomationProperties.AutomationId="{Binding RemoveId}" AutomationProperties.Name="{Binding RemoveName}" Click="OnRemoveModelClick" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" AutomationProperties.AutomationId="{Binding TitleId}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource StatCaption}" TextWrapping="Wrap" AutomationProperties.AutomationId="{Binding DetailId}" />
                        <TextBlock Text="{Binding Fit}" Style="{StaticResource StatCaption}" TextWrapping="Wrap" AutomationProperties.AutomationId="{Binding FitId}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatCaption}" TextWrapping="Wrap" AutomationProperties.AutomationId="{Binding StatusId}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- PB13, PB58: what was downloaded and the disk it takes, each removable, and every
                 model at once for working offline, the optional FP32 set included. -->
            <TextBlock Text="Everything at once" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <TextBlock x:Name="DownloadNote" AutomationProperties.AutomationId="DownloadNote"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Button x:Name="DownloadModelsButton" AutomationProperties.AutomationId="DownloadModelsButton"
                      Content="Download everything" Padding="12,4" Click="OnDownloadModelsClick" />
              <Button x:Name="CancelDownloadButton" AutomationProperties.AutomationId="CancelDownloadButton"
                      Content="Cancel" Padding="12,4" Margin="8,0,0,0" Visibility="Collapsed" Click="OnCancelDownloadClick" />
            </StackPanel>
            <ProgressBar x:Name="DownloadProgressBar" AutomationProperties.AutomationId="DownloadProgressBar"
                         Height="6" Maximum="1" Visibility="Collapsed" Margin="0,0,0,6" />
            <TextBlock x:Name="DownloadStatus" AutomationProperties.AutomationId="DownloadStatus"
                       Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- PB74: where downloads live, what is free there, and a way to move them. -->
            <DockPanel Margin="0,0,0,6">
              <Button x:Name="ModelsChangeFolder" AutomationProperties.AutomationId="ModelsChangeFolder" DockPanel.Dock="Right"
                      Content="Change folder" Padding="12,4" Click="OnModelsChangeFolderClick" />
              <TextBlock x:Name="ModelsLocation" AutomationProperties.AutomationId="ModelsLocation"
                         Style="{StaticResource StatCaption}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- PB58: before a first-use download, everything a person needs to say yes: what is
           downloaded and how large, from where, where it goes, that the photo stays here, and the
           license. It takes the stage's place, as About does, for the image surface's sake. -->
      <ScrollViewer x:Name="ConsentPanel" AutomationProperties.AutomationId="ConsentPanel" Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource GroupCard}" Padding="24" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock x:Name="ConsentTitle" AutomationProperties.AutomationId="ConsentTitle" Style="{StaticResource StatValue}" TextWrapping="Wrap" />
            <TextBlock x:Name="ConsentLead" AutomationProperties.AutomationId="ConsentLead" TextWrapping="Wrap" Margin="0,8,0,16" />

            <TextBlock Text="What is downloaded" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <ListBox x:Name="ConsentFiles" AutomationProperties.AutomationId="ConsentFiles" AutomationProperties.Name="What is downloaded"
                     IsHitTestVisible="False" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ConsentTotal" AutomationProperties.AutomationId="ConsentTotal" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,16" />

            <TextBlock Text="Good to know" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <TextBlock x:Name="ConsentFacts" AutomationProperties.AutomationId="ConsentFacts" Style="{StaticResource StatCaption}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock Text="License" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <TextBlock x:Name="ConsentLicense" AutomationProperties.AutomationId="ConsentLicense" Style="{StaticResource StatCaption}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Button x:Name="ConsentAccept" AutomationProperties.AutomationId="ConsentAccept" Padding="16,6" IsDefault="True" Click="OnConsentAccept" />
              <Button x:Name="ConsentDecline" AutomationProperties.AutomationId="ConsentDecline" Content="Not now" Padding="16,6" Margin="8,0,0,0"
                      IsCancel="True" Click="OnConsentDecline" />
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>

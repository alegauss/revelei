<!--
  PB37: the page styles claude-tray and quickshell share, in one dictionary the App merges.
  The rules, from quickshell's docs/design/friendly-shell: Fluent's own brushes on every themed
  surface (no colour is written here; Brand.cs holds the few that are ours), Segoe UI Variable,
  flat cards with a 1 px border and an 8 px radius, a 3 px accent underline for the selected
  destination, and status chips that carry a word rather than a colour alone.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- The rounded surface that holds a group of rows or a pane. -->
  <Style x:Key="GroupCard" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>

  <!-- Small muted label that titles a group or a pane. -->
  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,22,0,8" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>

  <!-- A hairline between rows, inset to align with the rows' text. -->
  <Style x:Key="RowDivider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- One measured number over its caption: time, size, PSNR. -->
  <Style x:Key="StatValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="StatCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- A status that carries a word ("GPU", "CPU", "Downloading"), never a coloured dot alone. -->
  <Style x:Key="StatusChip" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>

  <!-- A toolbar button's glyph (PB63), from the icon font Windows 11 ships, with Windows 10's
       before it as the fallback. The button carries the name and the tooltip; this is the picture. -->
  <Style x:Key="ToolbarIcon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Margin" Value="4,2" />
  </Style>

  <!-- A destination in a nav strip: quiet text, the accent underline under the selected one. -->
  <Style x:Key="NavDest" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="3" />
            </Grid.RowDefinitions>
            <Border x:Name="Hit" Grid.Row="0" Background="Transparent" CornerRadius="6" Padding="16,9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Bar" Grid.Row="1" Margin="10,0" CornerRadius="2" Visibility="Hidden"
                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hit" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

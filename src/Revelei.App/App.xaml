<!-- The theme is set on each window from Theme.Mode (PB37), never here: the sibling apps measured
     the Application-wide ThemeMode rendering differently from a window's. Styles.xaml holds the
     shared page styles; on Windows 11 the Fluent theme gives each window the Mica backdrop. -->
<Application x:Class="Revelei.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
